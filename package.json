{
  "name": "misty-states",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/core/api.ts",
    "./render": "./src/core/index.ts",
    "./kernel": "./src/core/kernel.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build && npm run build:lib",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && node scripts/boundary.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/svelte": "^5.4.2",
    "@types/js-yaml": "^4.0.9",
    "jsdom": "^30.0.1",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "js-yaml": "^5.2.3",
    "jspdf": "^4.2.1",
    "mp4-muxer": "^5.2.2",
    "svg2pdf.js": "^2.7.0"
  }
}
